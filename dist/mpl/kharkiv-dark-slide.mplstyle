# bausk-style 0.2.1 · look kharkiv · dark · slide · generated, do not edit.
# plt.style.use("<path>/kharkiv-dark-slide.mplstyle")  or  bausk_style.use("kharkiv", "dark", "slide")
# Fonts: bausk_style.use() registers the bundled TTFs; with plt.style.use() alone, install them (dist/fonts/ttf/) or DejaVu is used.
font.family: sans-serif
font.sans-serif: Fixel Text, DejaVu Sans
font.monospace: IBM Plex Mono, DejaVu Sans Mono
font.size: 20
axes.titlesize: 26
axes.titleweight: bold
axes.titlelocation: left
axes.labelsize: 20
xtick.labelsize: 18
ytick.labelsize: 18
legend.fontsize: 18
legend.frameon: False
text.color: f1f0ee
axes.labelcolor: bfbebb
axes.edgecolor: 999895
axes.facecolor: 100f0e
figure.facecolor: 100f0e
savefig.facecolor: 100f0e
axes.prop_cycle: cycler('color', ['f1f0ee', 'ed4b40', '7d7a77', '67a3e0', 'f0ba59', '7aa671'])
axes.spines.top: False
axes.spines.right: False
axes.linewidth: 1.80
axes.grid: True
axes.grid.axis: y
axes.axisbelow: True
grid.color: 373534
grid.linewidth: 1
xtick.color: 999895
ytick.color: 999895
xtick.labelcolor: 999895
ytick.labelcolor: 999895
lines.linewidth: 3
lines.solid_capstyle: butt
patch.edgecolor: 100f0e
image.cmap: cividis
figure.dpi: 150
savefig.dpi: 300
savefig.bbox: tight
svg.fonttype: none
pdf.fonttype: 42
