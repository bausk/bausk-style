# bausk-style 0.1.0 · look survey · light · slide · generated, do not edit.
# plt.style.use("<path>/survey-light-slide.mplstyle")  or  bausk_style.use("survey", "light", "slide")
# Fonts: matplotlib needs the TTF/OTF files installed (see guide/media/figures.md); otherwise DejaVu is used.
font.family: sans-serif
font.sans-serif: Sofia Sans Semi Condensed, DejaVu Sans
font.monospace: IBM Plex Mono, DejaVu Sans Mono
font.size: 20
axes.titlesize: 26
axes.titleweight: bold
axes.titlelocation: left
axes.labelsize: 20
xtick.labelsize: 18
ytick.labelsize: 18
legend.fontsize: 18
legend.frameon: False
text.color: 181b1e
axes.labelcolor: 44484d
axes.edgecolor: 5f6469
axes.facecolor: fafaf9
figure.facecolor: fafaf9
savefig.facecolor: fafaf9
axes.prop_cycle: cycler('color', ['007bab', 'a56b38', '255d34', 'b12083', 'b68b16', '181b1e'])
axes.spines.top: False
axes.spines.right: False
axes.linewidth: 1.80
axes.grid: True
axes.grid.axis: y
axes.axisbelow: True
grid.color: ccd3d1
grid.linewidth: 1
xtick.color: 5f6469
ytick.color: 5f6469
xtick.labelcolor: 5f6469
ytick.labelcolor: 5f6469
lines.linewidth: 3
lines.solid_capstyle: butt
patch.edgecolor: fafaf9
image.cmap: cividis
figure.dpi: 150
savefig.dpi: 300
savefig.bbox: tight
svg.fonttype: none
pdf.fonttype: 42
