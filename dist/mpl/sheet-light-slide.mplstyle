# bausk-style 0.1.0 · look sheet · light · slide · generated, do not edit.
# plt.style.use("<path>/sheet-light-slide.mplstyle")  or  bausk_style.use("sheet", "light", "slide")
# Fonts: matplotlib needs the TTF/OTF files installed (see guide/media/figures.md); otherwise DejaVu is used.
font.family: sans-serif
font.sans-serif: IBM Plex Sans, DejaVu Sans
font.monospace: IBM Plex Mono, DejaVu Sans Mono
font.size: 20
axes.titlesize: 26
axes.titleweight: bold
axes.titlelocation: left
axes.labelsize: 20
xtick.labelsize: 18
ytick.labelsize: 18
legend.fontsize: 18
legend.frameon: False
text.color: 1b2025
axes.labelcolor: 43484e
axes.edgecolor: 5f646a
axes.facecolor: f4f7f8
figure.facecolor: f4f7f8
savefig.facecolor: f4f7f8
axes.prop_cycle: cycler('color', ['1b2025', 'c52f15', '1762b6', '3d8e53', 'b6770b', '5288a2'])
axes.spines.top: False
axes.spines.right: False
axes.linewidth: 1.80
axes.grid: True
axes.grid.axis: y
axes.axisbelow: True
grid.color: caced1
grid.linewidth: 1
xtick.color: 5f646a
ytick.color: 5f646a
xtick.labelcolor: 5f646a
ytick.labelcolor: 5f646a
lines.linewidth: 3
lines.solid_capstyle: butt
patch.edgecolor: f4f7f8
image.cmap: cividis
figure.dpi: 150
savefig.dpi: 300
savefig.bbox: tight
svg.fonttype: none
pdf.fonttype: 42
