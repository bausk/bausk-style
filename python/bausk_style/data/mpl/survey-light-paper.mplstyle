# bausk-style 0.1.0 · look survey · light · paper · generated, do not edit.
# plt.style.use("<path>/survey-light-paper.mplstyle")  or  bausk_style.use("survey", "light", "paper")
# Fonts: matplotlib needs the TTF/OTF files installed (see guide/media/figures.md); otherwise DejaVu is used.
font.family: sans-serif
font.sans-serif: Sofia Sans Semi Condensed, DejaVu Sans
font.monospace: IBM Plex Mono, DejaVu Sans Mono
font.size: 8
axes.titlesize: 9
axes.titleweight: bold
axes.titlelocation: left
axes.labelsize: 8
xtick.labelsize: 7
ytick.labelsize: 7
legend.fontsize: 7
legend.frameon: False
text.color: 181b1e
axes.labelcolor: 44484d
axes.edgecolor: 5f6469
axes.facecolor: ffffff
figure.facecolor: ffffff
savefig.facecolor: ffffff
axes.prop_cycle: cycler('color', ['007bab', 'a56b38', '255d34', 'b12083', 'b68b16', '181b1e'])
axes.spines.top: False
axes.spines.right: False
axes.linewidth: 0.60
axes.grid: True
axes.grid.axis: y
axes.axisbelow: True
grid.color: ccd3d1
grid.linewidth: 0.4
xtick.color: 5f6469
ytick.color: 5f6469
xtick.labelcolor: 5f6469
ytick.labelcolor: 5f6469
lines.linewidth: 1
lines.solid_capstyle: butt
patch.edgecolor: ffffff
image.cmap: cividis
figure.dpi: 150
savefig.dpi: 300
savefig.bbox: tight
svg.fonttype: none
pdf.fonttype: 42
