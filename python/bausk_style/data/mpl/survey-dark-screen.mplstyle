# bausk-style 0.1.0 · look survey · dark · screen · generated, do not edit.
# plt.style.use("<path>/survey-dark-screen.mplstyle")  or  bausk_style.use("survey", "dark", "screen")
# Fonts: matplotlib needs the TTF/OTF files installed (see guide/media/figures.md); otherwise DejaVu is used.
font.family: sans-serif
font.sans-serif: Sofia Sans Semi Condensed, DejaVu Sans
font.monospace: IBM Plex Mono, DejaVu Sans Mono
font.size: 11
axes.titlesize: 13
axes.titleweight: bold
axes.titlelocation: left
axes.labelsize: 11
xtick.labelsize: 10
ytick.labelsize: 10
legend.fontsize: 10
legend.frameon: False
text.color: e4edf0
axes.labelcolor: b4c0c5
axes.edgecolor: 92a1a9
axes.facecolor: 0c1721
figure.facecolor: 0c1721
savefig.facecolor: 0c1721
axes.prop_cycle: cycler('color', ['60d8eb', '6ed889', 'f7bc50', 'ed74bd', 'c4936b', 'e4edf0'])
axes.spines.top: False
axes.spines.right: False
axes.linewidth: 0.96
axes.grid: True
axes.grid.axis: y
axes.axisbelow: True
grid.color: 2b3a47
grid.linewidth: 0.6
xtick.color: 92a1a9
ytick.color: 92a1a9
xtick.labelcolor: 92a1a9
ytick.labelcolor: 92a1a9
lines.linewidth: 1.6
lines.solid_capstyle: butt
patch.edgecolor: 0c1721
image.cmap: cividis
figure.dpi: 150
savefig.dpi: 300
savefig.bbox: tight
svg.fonttype: none
pdf.fonttype: 42
