# bausk-style 0.2.1 · look kharkiv · light · paper · generated, do not edit.
# plt.style.use("<path>/kharkiv-light-paper.mplstyle")  or  bausk_style.use("kharkiv", "light", "paper")
# Fonts: bausk_style.use() registers the bundled TTFs; with plt.style.use() alone, install them (dist/fonts/ttf/) or DejaVu is used.
font.family: sans-serif
font.sans-serif: Fixel Text, DejaVu Sans
font.monospace: IBM Plex Mono, DejaVu Sans Mono
font.size: 8
axes.titlesize: 9
axes.titleweight: bold
axes.titlelocation: left
axes.labelsize: 8
xtick.labelsize: 7
ytick.labelsize: 7
legend.fontsize: 7
legend.frameon: False
text.color: 100f0e
axes.labelcolor: 3f3d3b
axes.edgecolor: 5d5a59
axes.facecolor: ffffff
figure.facecolor: ffffff
savefig.facecolor: ffffff
axes.prop_cycle: cycler('color', ['100f0e', 'c91114', '7d7a77', '23588a', 'ac7d1b', '4a6e42'])
axes.spines.top: False
axes.spines.right: False
axes.linewidth: 0.60
axes.grid: True
axes.grid.axis: y
axes.axisbelow: True
grid.color: bfbebb
grid.linewidth: 0.4
xtick.color: 5d5a59
ytick.color: 5d5a59
xtick.labelcolor: 5d5a59
ytick.labelcolor: 5d5a59
lines.linewidth: 1
lines.solid_capstyle: butt
patch.edgecolor: ffffff
image.cmap: cividis
figure.dpi: 150
savefig.dpi: 300
savefig.bbox: tight
svg.fonttype: none
pdf.fonttype: 42
